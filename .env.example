# ─────────────────────────────────────────────────────────────────────────────
# Cross-Border Data Transfer Manager — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_DB=crossborder
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_strong_password_here

# Groq API key — get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# JWT Secret (min 32 characters)
JWT_SECRET=your_jwt_secret_min_32_chars_here

# Redis (optional override — defaults to redis:6379 in Docker)
REDIS_URL=redis://localhost:6379

# AI Service URL (override in Docker — defaults to localhost:5000)
AI_SERVICE_URL=http://localhost:5000
